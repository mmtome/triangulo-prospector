# Copie para .env. Nada aqui é obrigatório para prospectar — só para enviar ao
# gestor. Sem .env o app sobe e coleta normalmente; o botão "Enviar ao gestor"
# é que vai recusar.

# Porta do Prospector. 4546 e não 4545: o Prospector da Entusyasta usa a 4545,
# e as duas agências rodam na mesma máquina.
PORT=4546

# Onde o gestor da Triângulo está rodando.
# Em desenvolvimento: http://localhost:3000
# Em produção: https://triangulo-gestor.vercel.app
GESTOR_URL="http://localhost:3000"

# Segredo compartilhado com o gestor. O MESMO valor precisa estar no .env do
# gestor, também como PROSPECTOR_TOKEN — é ele que autoriza a rota de ingestão.
# Gere um novo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROSPECTOR_TOKEN=""

# Só se o Chrome não estiver no lugar padrão. O app procura sozinho em
# Program Files, no LOCALAPPDATA e no Edge antes de reclamar.
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Publicação das propostas na Vercel. Crie o projeto uma vez com
#   npx vercel project add triangulo-propostas
# e pegue o ID com `npx vercel project inspect triangulo-propostas`.
PROPOSTAS_PROJECT_ID=""
VERCEL_ORG_ID=""
